{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block title %}{{ account ? 'Edit' : 'New' }} YouTube Account{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1>{{ account ? 'Edit' : 'New' }} YouTube Account</h1>

            <form method="post">
                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input type="text" class="form-control" id="name" name="name" value="{{ account ? account.name : '' }}" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="{{ account ? account.email : '' }}" required>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="paused" name="paused" {{ account and account.paused ? 'checked' : '' }}>
                    <label class="form-check-label" for="paused">
                        Paused (no uploads will be processed)
                    </label>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Save
                    </button>
                    <a href="{{ path('pumukit_youtube_account_list') }}" class="btn btn-secondary">
                        <i class="fa fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
