<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}Add new Youtube account{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
    <form autocomplete="off" id="pumukit_youtube_create_account" action="{{ path('pumukit_youtube_create_account') }}" method="POST"
          data-controller="admin--modal-form" data-action="submit->admin--modal-form#submit"
          data-admin--modal-form-refresh-value="{{ [{target: '#list_youtube_accounts', url: path('pumukit_youtube_admin_list')}]|json_encode }}"
          data-admin--modal-form-success-message-value="{{ 'Youtube account was successfully created.'|trans }}"
          data-admin--modal-form-error-message-value="{{ 'There was an error on creating Youtube account.'|trans }}"
          data-admin--modal-form-disable-submit-value="true">
        <fieldset>
            {% for child in form %}
                {{ form_row(child) }}
            {% endfor %}
        </fieldset>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
            <button type="submit" class="btn btn-pumukit">{% trans %}Save changes{% endtrans %}</button>
        </div>
    </form>
</div>
