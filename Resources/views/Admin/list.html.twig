{% if tagsNotInitialized|default(false) %}
    <div class="alert alert-warning" role="alert">
        {{ "The tags of the bundle are not created. Run the command:"|trans }} <code>pumukit:youtube:init:pubchannel --force</code>
    </div>
{% endif %}
<div class="table-responsive">
    <table class="table table-striped table-hover pmk-tag-tree">
        <thead>
            {% include "@PumukitYoutube/Admin/listth.html.twig" %}
        </thead>
        <tbody>
            {% include '@PumukitYoutube/Admin/children.html.twig' %}
        </tbody>
        <tfoot>
        <tr>
            <td colspan="8" class="foot-td">&nbsp;</td>
        </tr>
        </tfoot>
    </table>
</div>
