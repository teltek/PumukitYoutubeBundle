{% if isPlaylist is defined and isPlaylist == true %}
    {% set playlist = true %}
{% else %}
    {% set playlist = false %}
{% endif %}

{% for tag in youtubeAccounts %}
    {% set has_children = tag.children|length %}

    {% if playlist == true %}
        {% set editPath = path('pumukit_youtube_edit_playlist', {'id' : tag.id }) %}
    {% else %}
        {% set editPath = path('pumukit_youtube_edit_account', {'id' : tag.id }) %}
        {% set createPath = path('pumukit_youtube_create_playlist', {'id': tag.id}) %}
    {% endif %}

    <tr class="tv_admin_row_0 c_{{ tag.path|replace({ ("|" ~ tag.cod ~ "|"): '', '|': ' c_'}) }} d_{{ tag.parent.cod|default("") }}" id="row_tag_{{ tag.id }}" data-level="{{ tag.level }}">
        <td headers="th-checkbox">
            <div class="form-check">
                <label>
                    <input id="{{ tag.id }}" class="tag_checkbox" type="checkbox">
                </label>
            </div>
        </td>
        <td headers="th-icons">
            <a href="#" title="{% trans %}Delete account{% endtrans %}" data-action="click->admin--tag-tree#remove"
               data-admin--tag-tree-id-param="{{ tag.id|json_encode }}" data-admin--tag-tree-pid-param="{{ tag.parent.id|default("")|json_encode }}"
               {% if tag.getNumberMultimediaObjects() > 0 %}data-admin--tag-tree-blocked-param="{{ 'Can not delete tag with code'|trans }} {{ tag.cod }}. {{ tag.getNumberMultimediaObjects() }} {{ 'Multimedia Object(s) has/have this tag'|trans }}."{% endif %}
               data-admin--tag-tree-confirm-param="{{ 'Are you sure?'|trans }} {{ tag.getTitle() }}"
               data-admin--tag-tree-success-param="{{ 'Tag'|trans }} &quot;{{ tag.getTitle() }}&quot; {{ 'successfully deleted'|trans }}.">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </td>

        <td headers="th-icons">
            <a title="{% trans %}Edit account{% endtrans %}" href="{{ editPath }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                <i class="fa-solid fa-pencil"></i>
            </a>
        </td>
        <td headers="th-icons">
            {% if playlist == false %}
                <a title="{% trans %}Add new playlist{% endtrans %}" href="{{ createPath }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                    <i class="fa-solid fa-square-plus"></i>
                </a>
            {% endif %}
        </td>
        <td headers="th-code">
            {{ tag.getCod() }}
        </td>
        <td headers="th-code-name" class="{{ has_children?'collapsed noload':'element' }}">
            <span class="pmk-padding-left-{{ 10 * tag.level }}" data-action="click->admin--tag-tree#toggle" data-admin--tag-tree-id-param="{{ tag.id|json_encode }}" data-admin--tag-tree-cod-param="{{ tag.cod|json_encode }}">
                <i class="fa-solid tag_icon tag_children_{{ tag.cod }}"></i>
            </span>
            {% if playlist == true %}
                {% trans %}PLAYLIST - {% endtrans %} {{ tag.getTitle() }}
            {% else %}
                {{ tag.getTitle() }} - {{ tag.getProperty('login') }}
            {% endif %}
        </td>
        <td headers="th-ytid">
             {% if playlist == true %}
                 {{ tag.getProperty('youtube')| default('Pending') }}
             {% endif %}
        </td>
        <td headers="th-num">
            {{ tag.getNumberMultimediaObjects() }}
        </td>
    </tr>

{% endfor %}
