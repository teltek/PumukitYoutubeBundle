<div id="pumukit_youtube_accounts"
     data-controller="youtube--publication"
     data-youtube--publication-channel-value="pub_channels_PUCHYOUTUBE"
     data-action="change@document->youtube--publication#toggle">
    {% if youtubeAccounts|length == 0 %}
        {% trans %}Please, create a new youtube account{% endtrans %}
    {% else %}
        {% set selectedAccount = youtubeAccounts|first %}
        {% set disabled = is_granted('ROLE_TAG_DISABLE_PUCHYOUTUBE') %}
        <div class="row">
            <div class="col-6">
                <label for="youtube_label" class="form-label">{{ "Youtube accounts"|trans }}</label>
                <select id="youtube_label" name="youtube_label" class="form-select" required {% if disabled %}disabled{% endif %}
                        data-youtube--publication-target="account" data-action="change->youtube--publication#changeAccount">
                    {% for account in youtubeAccounts %}
                        <option value="{{ account.getId() }}" {% if accountId == account.getId() %}selected{% endif %} data-url="{{ path('pumukityoutube_playlist_select', {'id' : account.getId() }) }}">{{ account.getTitle() }}</option>
                        {% if accountId == account.getId() %}
                            {% set selectedAccount = account %}
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div class="col-6">
                <label for="youtube_playlist_label" class="form-label">
                    {{ "Playlist"|trans }}
                    {% if multimediaObject.isPrototype() and (not disabled and is_granted('ROLE_ACCESS_YOUTUBE')) %}
                        <a id="create_yt_playlist" title="{{ "Create new playlist"|trans }}" href="{{ path('pumukit_youtube_create_playlist', {'id': selectedAccount.getId() }) }}"
                           data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal"
                           data-youtube--publication-target="create"
                           data-url="{{ path('pumukit_youtube_create_playlist', {'id': '__account__' }) }}">
                            <i class="fa-solid fa-square-plus"></i>
                        </a>
                        <a id="refresh_yt_playlist" href="#" title="{{ "Refresh playlists"|trans }}" data-action="click->youtube--publication#refresh">
                            <i class="fa-solid fa-arrows-rotate"></i>
                        </a>
                    {% endif %}
                </label>
                <select multiple id="youtube_playlist_label" name="youtube_playlist_label[]" class="form-select" required {% if disabled %}disabled{% endif %}
                        data-youtube--publication-target="playlists" data-action="change->youtube--publication#changePlaylists">
                    <option value="any" {% if not playlistId %}selected{% endif %}>{{ "Without playlist"|trans }}</option>
                    {% for playlist in selectedAccount.getChildren() %}
                        <option value="{{ playlist.getId() }}" {% if playlist.getId() in playlistId %}selected{% endif %}>{{ playlist.getTitle(app.request.getLocale()) }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    {% endif %}
</div>
