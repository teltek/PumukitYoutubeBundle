{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Youtube{% endtrans %}</li>
        </ul>
    </h3>

    <div class="row">
        <div class="col-md-12">
            <div class="pmk-well">
                <div id="list_youtube_accounts"
                     data-controller="admin--tag-tree"
                     data-admin--tag-tree-children-url-value="{{ path('pumukit_youtube_children_tag', {'id': '___id___'}) }}"
                     data-admin--tag-tree-delete-url-value="{{ path('pumukit_youtube_delete_tag', {'id': '___id___'}) }}"
                     data-admin--tag-tree-messages-value="{{ {withChildren: 'Tags with children can not be deleted.'|trans}|json_encode }}">
                    {{ render(controller('Pumukit\\YoutubeBundle\\Controller\\AdminController::listAction')) }}
                </div>

                <div class="text-end">
                    <a class="btn btn-pumukit" title="{% trans %}New account{% endtrans %}" href="{{ path('pumukit_youtube_create_account') }}" data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal">
                        <i class="fa-solid fa-pencil"></i> {% trans %}New account{% endtrans %}
                    </a>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
