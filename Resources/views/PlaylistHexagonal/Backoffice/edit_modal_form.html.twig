<form id="editPlaylistForm" method="POST">
    <div class="form-group">
        <label for="editTitle">Title <span class="text-danger">*</span></label>
        <input type="text" 
               class="form-control" 
               id="editTitle" 
               name="title" 
               value="{{ playlist.title }}"
               required 
               maxlength="150">
    </div>

    <div class="form-group">
        <label for="editDescription">Description</label>
        <textarea class="form-control" 
                  id="editDescription" 
                  name="description" 
                  rows="4"
                  maxlength="5000">{{ playlist.description }}</textarea>
    </div>

    <div class="form-group">
        <label for="editPrivacy">Privacy Status</label>
        <select class="form-control" id="editPrivacy" name="privacy">
            <option value="public" {% if playlist.privacy == 'public' %}selected{% endif %}>Public</option>
            <option value="unlisted" {% if playlist.privacy == 'unlisted' %}selected{% endif %}>Unlisted</option>
            <option value="private" {% if playlist.privacy == 'private' %}selected{% endif %}>Private</option>
        </select>
    </div>
</form>
