<div class="well">
    <table class="table table-striped table-hover pmk-tag-tree">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Privacy</th>
                <th>Video Count</th>
                <th>Created At</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% if playlists is not empty %}
                {% for playlist in playlists %}
                    <tr>
                        <td>{{ playlist.title }}</td>
                        <td>{{ playlist.description|slice(0, 50) ~ (playlist.description|length > 50 ? '...' : '') }}</td>
                        <td><span class="badge badge-{{ playlist.privacy == 'public' ? 'success' : 'warning' }}">{{ playlist.privacy }}</span></td>
                        <td>{{ playlist.videoCount }}</td>
                        <td>{{ playlist.createdAt.format('Y-m-d H:i:s') }}</td>
                        <td>
                            <a href="#" class="btn btn-sm btn-info" title="Edit">
                                <i class="mdi mdi-pencil"></i>
                            </a>
                            <a href="#" class="btn btn-sm btn-danger" title="Delete">
                                <i class="mdi mdi-delete"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">No playlists found.</td>
                </tr>
            {% endif %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="6" class="foot-td">
                    &nbsp;
                </td>
            </tr>
        </tfoot>
    </table>
</div>
