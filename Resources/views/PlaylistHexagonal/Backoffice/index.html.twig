{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block title %}YouTube Playlists Management{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>
                <i class="fab fa-youtube" style="color: #FF0000;"></i> 
                YouTube Playlists Management (Hexagonal)
            </h2>
            <hr>

            {# Account Selection #}
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Select YouTube Account</h5>
                </div>
                <div class="card-body">
                    <form method="GET" action="{{ path('pumukit_youtube_playlists_index') }}" class="form-inline">
                        <div class="form-group mr-3">
                            <label for="accountSelect" class="mr-2">Account:</label>
                            <select name="account" id="accountSelect" class="form-control" onchange="this.form.submit()">
                                <option value="">-- Select Account --</option>
                                {% for account in accounts %}
                                    <option value="{{ account.getId() }}" 
                                            {% if selectedAccount and selectedAccount.getId() == account.getId() %}selected{% endif %}>
                                        {{ account.accountName }} ({{ account.channelId }})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <noscript>
                            <button type="submit" class="btn btn-primary">Load Playlists</button>
                        </noscript>
                    </form>
                </div>
            </div>

            {% if selectedAccount %}
                {# Create New Playlist Button #}
                <div class="mb-3">
                    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#createPlaylistModal">
                        <i class="fas fa-plus"></i> Create New Playlist
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="location.reload()">
                        <i class="fas fa-sync"></i> Refresh
                    </button>
                </div>

                {# Playlists Table #}
                <div class="card">
                    <div class="card-header">
                        <h5>Playlists for {{ selectedAccount.accountName }}</h5>
                    </div>
                    <div class="card-body">
                        {% if playlists|length > 0 %}
                            <table class="table table-striped table-hover" id="playlistsTable">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Privacy</th>
                                        <th>Video Count</th>
                                        <th>Created At</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for playlist in playlists %}
                                        <tr data-playlist-id="{{ playlist.youtubeId }}">
                                            <td>
                                                <strong>{{ playlist.title }}</strong>
                                                <br>
                                                <small class="text-muted">{{ playlist.description|slice(0, 100) }}{% if playlist.description|length > 100 %}...{% endif %}</small>
                                            </td>
                                            <td>{{ playlist.description|slice(0, 50) }}{% if playlist.description|length > 50 %}...{% endif %}</td>
                                            <td>
                                                <span class="badge badge-{{ playlist.privacy == 'public' ? 'success' : 'warning' }}">
                                                    {{ playlist.privacy|upper }}
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge badge-info">
                                                    {{ playlist.videoCount }} videos
                                                </span>
                                            </td>
                                            <td>
                                                <small>{{ playlist.createdAt.format('Y-m-d H:i') }}</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" 
                                                            class="btn btn-sm btn-primary"
                                                            onclick="loadEditPlaylistModal('{{ playlist.getId() }}')">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </button>
                                                    <button type="button" 
                                                            class="btn btn-sm btn-danger"
                                                            onclick="deletePlaylist('{{ playlist.getId() }}', '{{ playlist.title|escape('js') }}')">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No playlists found for this account.
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> Please select a YouTube account to view playlists.
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script type="text/javascript">
    function loadEditPlaylistModal(playlistId) {
        // Load the edit form via AJAX
        fetch('{{ path('pumukit_youtube_playlists_edit_hexagonal', {'id': 'PLAYLIST_ID'}) }}'.replace('PLAYLIST_ID', playlistId), {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Set the form HTML in the modal
                document.getElementById('editPlaylistModalBody').innerHTML = data.formHtml;
                
                // Store the playlist ID for submission
                document.getElementById('editPlaylistForm').playlistId = playlistId;
                document.getElementById('editPlaylistForm').accountId = data.accountId;
                
                // Show the modal
                $('#editPlaylistModal').modal('show');
            } else {
                alert('Error loading form: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error loading edit form');
        });
    }

    function submitEditPlaylist() {
        const playlistId = document.getElementById('editPlaylistForm').playlistId;
        const accountId = document.getElementById('editPlaylistForm').accountId;
        const title = document.getElementById('editTitle').value;
        const description = document.getElementById('editDescription').value;
        const privacy = document.getElementById('editPrivacy').value;

        if (!title) {
            alert('Please enter a playlist title');
            return;
        }

        fetch('{{ path('pumukit_youtube_playlists_edit_hexagonal', {'id': 'PLAYLIST_ID'}) }}'.replace('PLAYLIST_ID', playlistId), {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'title=' + encodeURIComponent(title) + 
                  '&description=' + encodeURIComponent(description) +
                  '&privacy=' + encodeURIComponent(privacy)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Playlist updated successfully');
                // Close modal
                $('#editPlaylistModal').modal('hide');
                // Reload page
                location.reload();
            } else {
                alert('Error updating playlist: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error updating playlist');
        });
    }

    function deletePlaylist(playlistId, playlistTitle) {
        if (confirm('Are you sure you want to delete the playlist "' + playlistTitle + '"?')) {
            // Use Fetch API to send DELETE request
            fetch('{{ path('pumukit_youtube_playlists_delete', {'id': 'PLAYLIST_ID'}) }}'.replace('PLAYLIST_ID', playlistId), {
                method: 'DELETE',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    // Reload the page after successful deletion
                    location.reload();
                } else {
                    alert('Error deleting playlist');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting playlist');
            });
        }
    }

    function createPlaylist() {
        const title = document.getElementById('createTitle').value;
        const description = document.getElementById('createDescription').value;
        const privacy = document.getElementById('createPrivacy').value;
        const accountId = '{{ selectedAccount ? selectedAccount.getId() : '' }}';

        if (!title) {
            alert('Please enter a playlist title');
            return;
        }

        fetch('{{ path('pumukit_youtube_playlists_create') }}', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                accountId: accountId,
                title: title,
                description: description,
                privacy: privacy
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Playlist created successfully');
                // Reset form
                document.getElementById('createPlaylistForm').reset();
                // Close modal
                $('#createPlaylistModal').modal('hide');
                // Reload page
                location.reload();
            } else {
                alert('Error creating playlist: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error creating playlist');
        });
    }
</script>

{# Modal: Edit Playlist #}
<div class="modal fade" id="editPlaylistModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-edit"></i> Edit Playlist
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="editPlaylistModalBody">
                <!-- Form will be loaded here via AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitEditPlaylist()">Save Changes</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createPlaylistModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus"></i> Create New Playlist
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="createPlaylistForm">
                    <div class="form-group">
                        <label for="createTitle">Title <span class="text-danger">*</span></label>
                        <input type="text" 
                               class="form-control" 
                               id="createTitle" 
                               name="title" 
                               required 
                               maxlength="150"
                               placeholder="My awesome playlist">
                        <small class="form-text text-muted">Max 150 characters</small>
                    </div>

                    <div class="form-group">
                        <label for="createDescription">Description</label>
                        <textarea class="form-control" 
                                  id="createDescription" 
                                  name="description" 
                                  rows="4"
                                  maxlength="5000"
                                  placeholder="Playlist description..."></textarea>
                        <small class="form-text text-muted">Max 5000 characters</small>
                    </div>

                    <div class="form-group">
                        <label for="createPrivacy">Privacy Status</label>
                        <select class="form-control" id="createPrivacy" name="privacy">
                            <option value="public">Public</option>
                            <option value="unlisted">Unlisted</option>
                            <option value="private" selected>Private</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="createPlaylist()">Create Playlist</button>
            </div>
        </div>
    </div>
</div>

{% endblock %}
