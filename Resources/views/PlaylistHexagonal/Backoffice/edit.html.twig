{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block title %}Edit Playlist{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-edit"></i> Edit Playlist: {{ playlist.title }}
                    </h4>
                </div>
                <div class="card-body">
                    <form method="POST" action="{{ path('pumukit_youtube_playlists_edit_hexagonal', {'id': playlist.getId()}) }}">
                        <div class="form-group">
                            <label for="title">Title <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control" 
                                   id="title" 
                                   name="title" 
                                   value="{{ playlist.title }}"
                                   required 
                                   maxlength="150">
                        </div>

                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea class="form-control" 
                                      id="description" 
                                      name="description" 
                                      rows="6"
                                      maxlength="5000">{{ playlist.description }}</textarea>
                        </div>

                        <div class="form-group">
                            <label for="privacy">Privacy Status</label>
                            <select class="form-control" id="privacy" name="privacy">
                                <option value="public" {% if playlist.privacy == 'public' %}selected{% endif %}>Public</option>
                                <option value="unlisted" {% if playlist.privacy == 'unlisted' %}selected{% endif %}>Unlisted</option>
                                <option value="private" {% if playlist.privacy == 'private' %}selected{% endif %}>Private</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>YouTube ID (Read-only)</label>
                            <input type="text" 
                                   class="form-control" 
                                   value="{{ playlist.youtubeId }}"
                                   readonly>
                        </div>

                        <div class="form-group">
                            <label>Video Count</label>
                            <input type="number" 
                                   class="form-control" 
                                   value="{{ playlist.videoCount }}"
                                   readonly>
                        </div>

                        <div class="form-group">
                            <label>Created At</label>
                            <input type="text" 
                                   class="form-control" 
                                   value="{{ playlist.createdAt.format('Y-m-d H:i:s') }}"
                                   readonly>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a href="{{ path('pumukit_youtube_playlists_index', {'account': playlist.accountId}) }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
