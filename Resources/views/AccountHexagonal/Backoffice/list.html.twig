<div class="well">
    <table class="table table-striped table-hover pmk-tag-tree">
        <thead>
            <tr>
                <th>Account Name</th>
                <th>Channel ID</th>
                <th>Credentials Path</th>
                <th>Status</th>
                <th>Created At</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% if accounts is not empty %}
                {% for account in accounts %}
                    <tr>
                        <td>{{ account.accountName }}</td>
                        <td>{{ account.channelId }}</td>
                        <td>{{ account.credentialsPath }}</td>
                        <td>
                            {% if account.paused %}
                                <span class="badge badge-danger">Paused</span>
                            {% else %}
                                <span class="badge badge-success">Active</span>
                            {% endif %}
                        </td>
                        <td>{{ account.createdAt.format('Y-m-d H:i:s') }}</td>
                        <td>
                            <a href="#" class="btn btn-sm btn-info" title="Edit">
                                <i class="mdi mdi-pencil"></i>
                            </a>
                            <a href="#" class="btn btn-sm btn-danger" title="Delete">
                                <i class="mdi mdi-delete"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">No YouTube accounts configured yet.</td>
                </tr>
            {% endif %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="6" class="foot-td">
                    &nbsp;
                </td>
            </tr>
        </tfoot>
    </table>
</div>
