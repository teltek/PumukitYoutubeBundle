{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block title %}YouTube Accounts Management{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>
                <i class="fab fa-youtube" style="color: #FF0000;"></i> 
                YouTube Accounts Management (Hexagonal)
            </h2>
            <hr>

            {# Create New Account Button #}
            <div class="mb-3">
                <button class="btn btn-success" data-toggle="modal" data-backdrop="static" data-target="#createAccountModal">
                    <i class="fas fa-plus"></i> Create New Account
                </button>
            </div>

            {# Accounts Table #}
            <div class="card">
                <div class="card-header">
                    <h5>YouTube Accounts ({{ total }} account{{ total != 1 ? 's' : '' }})</h5>
                </div>
                <div class="card-body">
                    {% if accounts is not empty %}
                        <table class="table table-striped table-hover" id="accountsTable">
                            <thead>
                                <tr>
                                    <th>Account Name</th>
                                    <th>Channel ID</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for account in accounts %}
                                    <tr data-account-id="{{ account.getId() }}">
                                        <td>
                                            <strong>{{ account.accountName }}</strong>
                                            <br>
                                            <small class="text-muted">{{ account.credentialsPath }}</small>
                                        </td>
                                        <td>
                                            <code>{{ account.channelId }}</code>
                                        </td>
                                        <td>
                                            <span class="badge badge-{{ account.paused ? 'danger' : 'success' }}">
                                                {{ account.paused ? 'Paused' : 'Active' }}
                                            </span>
                                        </td>
                                        <td>
                                            <small>{{ account.createdAt.format('Y-m-d H:i') }}</small>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('pumukit_youtube_edit_account', {'id': account.getId()}) }}" 
                                                   class="btn btn-sm btn-primary" 
                                                   data-toggle="modal" 
                                                   data-backdrop="static" 
                                                   data-target="#myModal">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <button type="button" 
                                                        class="btn btn-sm btn-danger"
                                                        onclick="deleteAccount('{{ account.getId() }}', '{{ account.accountName|escape('js') }}')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No YouTube accounts configured yet. 
                            <a href="{{ path('pumukit_youtube_create_account') }}" data-toggle="modal" data-backdrop="static" data-target="#myModal">Create one now</a>.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function deleteAccount(accountId, accountName) {
        if (confirm('Are you sure you want to delete the account "' + accountName + '"?')) {
            // Use Fetch API to send DELETE request
            fetch('{{ path('pumukit_youtube_accounts_delete', {'id': 'ACCOUNT_ID'}) }}'.replace('ACCOUNT_ID', accountId), {
                method: 'DELETE',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    // Reload the page after successful deletion
                    location.reload();
                } else {
                    alert('Error deleting account');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting account');
            });
        }
    }
</script>

{# Modal for Creating Accounts (Hexagonal - with Messenger) #}
<div class="modal fade" id="createAccountModal" tabindex="-1" role="dialog" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createAccountModalLabel">
                    <i class="fab fa-youtube" style="color: #FF0000;"></i> Create YouTube Account
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="createAccountForm">
                    <div class="form-group">
                        <label for="accountLogin">Account Login *</label>
                        <input type="text" class="form-control" id="accountLogin" placeholder="e.g., my-channel" required>
                        <small class="form-text text-muted">Unique identifier for the account</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="accountTitleEs">Account Title (Spanish) *</label>
                        <input type="text" class="form-control" id="accountTitleEs" placeholder="e.g., Mi Canal" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="accountTitleEn">Account Title (English) *</label>
                        <input type="text" class="form-control" id="accountTitleEn" placeholder="e.g., My Channel" required>
                    </div>

                    <div id="createAccountMessage" style="display:none;" class="alert" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitCreateAccount()">
                    <i class="fas fa-check"></i> Create Account
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function submitCreateAccount() {
        const login = document.getElementById('accountLogin').value;
        const titleEs = document.getElementById('accountTitleEs').value;
        const titleEn = document.getElementById('accountTitleEn').value;
        const messageDiv = document.getElementById('createAccountMessage');

        if (!login || !titleEs || !titleEn) {
            messageDiv.className = 'alert alert-danger';
            messageDiv.textContent = '❌ All fields are required';
            messageDiv.style.display = 'block';
            return;
        }

        const payload = {
            login: login,
            i18n_title: {
                es: titleEs,
                en: titleEn
            }
        };

        messageDiv.style.display = 'block';
        messageDiv.className = 'alert alert-info';
        messageDiv.textContent = '⏳ Creating account...';

        fetch('{{ path("pumukit_youtube_accounts_create") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                messageDiv.className = 'alert alert-success';
                messageDiv.innerHTML = '✅ <strong>Account created successfully!</strong><br>' +
                    '<small>Message dispatched to messenger queue. Reloading page...</small>';
                
                setTimeout(() => {
                    location.reload();
                }, 2000);
            } else {
                messageDiv.className = 'alert alert-danger';
                messageDiv.textContent = '❌ Error: ' + (data.message || 'Unknown error');
            }
        })
        .catch(error => {
            messageDiv.className = 'alert alert-danger';
            messageDiv.textContent = '❌ Error: ' + error.message;
        });
    }

    // Allow Enter key to submit
    document.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && document.getElementById('createAccountModal').classList.contains('show')) {
            submitCreateAccount();
        }
    });
</script>

{% endblock %}
