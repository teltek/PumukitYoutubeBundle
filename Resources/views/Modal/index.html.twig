{% if youtube_status|lower == 'error' or youtube_status|lower == 'removed' or youtube_status|lower == 'duplicated' %}
    {% set label_class = "text-bg-danger" %}
{% elseif youtube_status|lower == 'published' %}
    {% set label_class = "text-bg-success" %}
{% else %}
    {% set label_class = "text-bg-warning" %}
{% endif %}

<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">
       {{ "Youtube"|trans|upper }}
    </h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body" data-controller="youtube--video">
    <div class="row">
    <div class="col-md-7">
        <div class="row">
            <div class="col-md-6 text-end">
                <strong>{% trans %}Multimedia Object title{% endtrans %}</strong>
            </div>
            <div class="col-md-6 text-start">
                {{ mm.title }}
            </div>
        </div>
        <hr />

        {% if youtube.youtubeAccount is defined and youtube.youtubeAccount is not empty %}
            <div class="row">
                <div class="col-md-6 text-end">
                    <strong>{% trans %}Youtube account{% endtrans %}</strong>
                </div>
                <div class="col-md-6 text-start">
                    {{ youtube.youtubeAccount }}
                </div>
            </div>
            <hr />
        {% endif %}

        <div class="row">
            <div class="col-md-6 text-end">
                <strong>{% trans %}Youtube Playlists{% endtrans %}</strong>
            </div>
            <div class="col-md-6 text-start">
                {% for key, playlist in youtube.playlists %}
                <div class="input-group">
                    {{ playlist_name(key) }}
                    <span class="input-group-text">
                        <a href="{{ youtube.link }}&list={{ key }}" target="_blank" title="{{ "Go to playlist"|trans }}">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    </span>
                </div>
                {% else %}
                    ---
                {% endfor %}
            </div>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-6 text-end">
                <strong>{% trans %}Youtube Status{% endtrans %}</strong>
            </div>
            <div class="col-md-6 text-start">
                <span class="badge {{ label_class }}">
                    {{ youtube_status|upper }}
                </span>
            </div>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-6 text-end">
                <strong>{% trans %}File uploaded{% endtrans %}</strong>
            </div>
            <div class="col-md-6 text-start">
                {% if attribute(youtube, 'getFileUploaded') is defined and youtube.getFileUploaded() is not empty %}
                  {{ youtube.getFileUploaded() }}
                {% else %}
                    <span> {{ "File not saved on database"|trans }}</span>
                {% endif %}
            </div>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-6 text-end">
                <strong>{% trans %}Last Updated{% endtrans %}</strong>
            </div>
            <div class="col-md-6 text-start">
                {{ youtube.getSyncMetadataDate()| format_datetime("medium", "none",locale=app.request.getLocale()) }}
            </div>
        </div>
        <hr />

        {% if youtube_status in ['published', 'proccessing'] %}
            <div class="row">
                <div class="col-md-6">
                    <button type="button" class="btn btn-secondary" title="{{ "Copy Youtube link"|trans }}" data-action="click->admin--actions#copy" data-admin--actions-input-param="copy-youtube-link">
                        {{ "Copy Youtube link"|trans }}
                    </button>
                    <input id="copy-youtube-link" type="text" value="{{ youtube.link }}" class="pmk-display-none"/>
                </div>
                <div class="col-md-6">
                    <button type="button" class="btn btn-secondary" title="{{ "Copy iframe"|trans }}" data-action="click->admin--actions#copy" data-admin--actions-input-param="copy-embed-link">
                        {{ "Copy iframe"|trans }}
                    </button>
                    <input id="copy-embed-link" type="text" value="{{ youtube.embed }}" class="pmk-display-none"/>
                </div>
            </div>
            <hr />
        {% endif %}
    </div>
    <div class="col-md-5">

        <div class="row">
            <div class="col-md-12 text-center">
                <a class="btn btn-secondary mb-2" href="{{ youtube.link }}" title="{{ "Show video on Youtube"|trans }}">
                    {{ "Show video on Youtube"|trans }}
                </a>
            </div>
        </div>

        {% if youtube_status in ['published'] %}
            <div class="row">
                <div class="col-md-12 text-center">
                    <a href="#" class="btn btn-pumukit mb-2" title="{{ "Manual playlist update"|trans }}"
                       data-action="click->youtube--video#run"
                       data-youtube--video-url-param="{{ path('pumukityoutube_updateplaylist', {'id': mm.id}) }}"
                       data-youtube--video-success-param="{{ 'Update playlist successfully'|trans }}"
                       data-youtube--video-error-param="{{ 'The video could not be updated on YouTube.'|trans }}">
                       {{ "Update playlist"|trans }}
                    </a>
                </div>
            </div>
        {% endif %}
        <div class="row">
            <div class="col-md-12 text-center">
                <a href="#" class="btn btn-pumukit mb-2" title="{{ "Force upload video"|trans }}"
                   data-action="click->youtube--video#run"
                   data-youtube--video-url-param="{{ path('pumukityoutube_force_upload', {'id': mm.id}) }}"
                   data-youtube--video-confirm-param="{{ 'Do you want force upload this video? This action will delete old video causing lose all views on Youtube'|trans }}"
                   data-youtube--video-success-param="{{ 'Update video successfully'|trans }}"
                   data-youtube--video-error-param="{{ 'The video could not be updated on YouTube.'|trans }}">
                    {{ "Force upload video"|trans }}
                </a>
            </div>
        </div>
    </div>

    </div>
</div>

