{% extends 'base.html.twig' %}

{% block title %}Video Not Uploaded{% endblock %}

{% block content %}
<div style="padding: 40px; text-align: center;">
    <div style="max-width: 600px; margin: 0 auto; background: white; padding: 40px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="#6c757d" style="margin-bottom: 20px;">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        
        <h2 style="font-size: 24px; color: #333; margin-bottom: 15px;">Video Not Uploaded to YouTube</h2>
        
        <p style="color: #6c757d; font-size: 16px; margin-bottom: 25px;">
            This MultimediaObject has not been uploaded to YouTube yet.
        </p>
        
        <p style="color: #495057; font-size: 14px;">
            <strong>{{ multimediaObject.title }}</strong>
        </p>
        
        <div style="margin-top: 30px;">
            <a href="{{ path('pumukitadmin_mms_list') }}" class="btn" style="background: #007bff; color: white; padding: 10px 30px; text-decoration: none; border-radius: 4px; display: inline-block;">
                Back to Multimedia Objects
            </a>
        </div>
    </div>
</div>
{% endblock %}
