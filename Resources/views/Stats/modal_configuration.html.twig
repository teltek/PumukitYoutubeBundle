<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}Youtube Configuration{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <table class="table">
        <tbody><tr>
            <th width="1%">#</th>
            <th>Parameter</th>
            <th>Value</th>
        </tr>
            {% for parameter, value in youtubeConfiguration %}
                <tr>
                    <td>{{ loop.index }}.</td>
                    <td>{{ parameter }}</td>
                    <td>
                        {% for val in value %}
                            {{ val }}
                        {% else %}
                            {% if value is same as(false) %}
                                <i class="fa-solid fa-check"></i>
                            {% elseif value is same as(true) %}
                                <i class="fa-solid fa-xmark"></i>
                            {% else %}
                                {{ value }}
                            {% endif %}
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
