<h3 class="cab_body_div">
    <ul class="breadcrumb pmk-margin-bottom-5">
        <li class="active breadcrumb-item">
            {{ "YouTube Global Stats"|trans }}
            <a href="{{ path('pumukit_youtube_configuration') }}"  data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal" title="{{ "Youtube Global Configuration"|trans }}">
                <i class="text-info fa-solid fa-circle-info"></i>
            </a>
        </li>
    </ul>
</h3>

<div class="row">
    <div class="col-md-12">
        <div class="row">

            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box">
                    <span class="info-box-icon text-bg-warning">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text" data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ "Number of accounts"|trans }}">{{ "Number of accounts"|trans }}</span>
                        <span class="info-box-number">
                            {{ accountsStats|length }}
                        </span>
                    </div>
                </div>
            </div>


            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box">
                    <span class="info-box-icon text-bg-primary">
                        <i class="fa-solid fa-list"></i>

                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text" data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ "Number of playlist"|trans }}">{{ "Number of playlist"|trans }}</span>
                        <span class="info-box-number">
                            {% set playlistNumber = 0 %}
                            {% for account in youtubeAccounts %}
                                {% set playlistNumber = playlistNumber + account.getChildren()|length %}
                            {% endfor %}
                            {{ playlistNumber }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box">
                    <span class="info-box-icon text-bg-success">
                        <i class="fa-solid fa-play"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text" data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ "Number of videos"|trans }}">{{ "Number of videos"|trans }}</span>
                        <span class="info-box-number">
                            {% set videosNumber = 0 %}
                            {% for account in accountsStats %}
                                {% set videosNumber = videosNumber + account %}
                            {% endfor %}
                            {{ videosNumber }}
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
