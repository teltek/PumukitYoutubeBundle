<h3 class="cab_body_div">
    <ul class="breadcrumb pmk-margin-bottom-5">
        <li class="active breadcrumb-item">
            {{ "Youtube Status Stats"|trans }}
        </li>
    </ul>
</h3>


<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-3 col-sm-6 col-12">
                <a class="youtube_status_link_list" href="{{ path('pumukit_youtube_stat_list', {'status': constant('Pumukit\\YoutubeBundle\\Document\\Youtube::STATUS_PROCESSING') }) }}">
                    <div class="info-box">
                        <span class="info-box-icon text-bg-info">
                            {{ "Processing"|trans|first|upper }}
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-number">
                                <span class="info-box-text"> {{ "Processing"|trans }}</span>
                                {% set number = processing_videos_count() %}
                                {{ number }}
                                <small>
                                    {{ "{0} videos|{1} video|]1,Inf] videos"|trans({'%count%': number }) }}
                                </small>
                            </span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6 col-12">
                <a class="youtube_status_link_list" href="{{ path('pumukit_youtube_stat_list', {'status': 3 }) }}">
                    <div class="info-box">
                        <span class="info-box-icon text-bg-info">
                            {{ "Published"|trans|first|upper }}
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-number">
                                <span class="info-box-text"> {{ "Published"|trans }}</span>
                                {% set number = published_videos_count() %}
                                {{ number }}
                                <small>
                                    {{ "{0} videos|{1} video|]1,Inf] videos"|trans({'%count%': number }) }}
                                </small>
                            </span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6 col-12">
                <a class="youtube_status_link_list" href="{{ path('pumukit_youtube_stat_list', {'status': 8 }) }}">
                    <div class="info-box">
                        <span class="info-box-icon text-bg-info">
                            {{ "Removed"|trans|first|upper }}
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-number">
                                <span class="info-box-text"> {{ "Removed"|trans }}</span>
                                {% set number = removed_videos_count() %}
                                {{ number }}
                                <small>
                                    {{ "{0} videos|{1} video|]1,Inf] videos"|trans({'%count%': number }) }}
                                </small>
                            </span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6 col-12">
                <a class="youtube_status_link_list" href="{{ path('pumukit_youtube_stat_list', {'status': 10 }) }}">
                    <div class="info-box">
                        <span class="info-box-icon text-bg-info">
                            {{ "To delete"|trans|first|upper }}
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-number">
                                <span class="info-box-text"> {{ "To delete"|trans }}</span>
                                {% set number = to_delete_videos_count() %}
                                {{ number }}
                                <small>
                                    {{ "{0} videos|{1} video|]1,Inf] videos"|trans({'%count%': number }) }}
                                </small>
                            </span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
