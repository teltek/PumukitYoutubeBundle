{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">
                <a href="{{ path('pumukit_youtube_stat_index') }}">YouTube</a> /
                {{ "YouTube List"|trans }} ({{ title|trans|capitalize }})
            </li>
        </ul>
    </h3>

    <div class="pmk-well">
        {% if filters is defined %}
            {% set filterLabels = {'needs-action': 'Needs action', 'will-be-retried': 'Will be retried'} %}
            <div class="btn-group btn-group-sm mb-3" role="group">
                {% for option in filters %}
                    <a class="btn {{ option == filter ? 'btn-pumukit' : 'btn-secondary' }}" href="{{ path('pumukit_youtube_stat_by_error', option ? {type: option} : {}) }}">
                        {{ (option ? filterLabels[option] : 'All')|trans }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
        {% if youtubeDocuments|length > 0 %}
            <table class="table table-striped">
                <thead>
                    {% include "@PumukitYoutube/Stats/template_list_head.html.twig" %}
                </thead>
                <tbody>
                    {% include '@PumukitYoutube/Stats/template_list_body.html.twig' %}
                </tbody>
            </table>

            <div class="text-center">
                {{ pagerfanta(youtubeDocuments, 'twitter_bootstrap5') }}
            </div>

        {% else %}
            <strong>
                {{ "Without results"|trans }}
            </strong>
        {% endif %}
    </div>
{% endblock %}
