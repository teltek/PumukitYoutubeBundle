<link href="{{ asset('bundles/pumukityoutube/css/select2.min.css') }}" rel="stylesheet"/>
<script src="{{ asset('bundles/pumukityoutube/js/select2.min.js') }}"></script>

<div class="form-group" id="pumukit_youtube_accounts">
    {% if youtubeAccounts|length == 0 %}
        <div class="col-xs-12">
            {% trans %}Please, create a new youtube account{% endtrans %}
            <p><a href="{{ path('pumukit_youtube_admin_list') }}" target="_blank">{% trans %}Go to YouTube Management{% endtrans %}</a></p>
        </div>
    {% else %}
        <div class="col-xs-6" style="padding-left: 0;">
            <label for="youtube_label">{{ "Youtube accounts"|trans }}</label>
            <select id="youtube_label" name="youtube_label" class="form-control" required {% if is_granted('ROLE_TAG_DISABLE_PUCHYOUTUBE') %}disabled{% endif %}>
                <option value="">-- {{ "Select account"|trans }} --</option>
                {% for account in youtubeAccounts %}
                    <option value="{{ account.id }}" 
                            {% if selectedAccountId == account.id %}selected{% endif %}
                            data-account-id="{{ account.id }}">
                        {{ account.accountName }}{% if account.login %} ({{ account.login }}){% endif %}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-xs-6">
            <label for="youtube_playlist_label">{{ "Playlists"|trans }}</label>
            <select multiple id="youtube_playlist_label" name="youtube_playlist_label[]" class="form-control" style="width:100%" {% if is_granted('ROLE_TAG_DISABLE_PUCHYOUTUBE') %}disabled{% endif %}>
                <option value="any">{{ "Without playlist"|trans }}</option>
            </select>
        </div>
    {% endif %}
</div>

<script type="text/javascript">
(function() {
    'use strict';

    const accountSelect = $('#youtube_label');
    const playlistSelect = $('#youtube_playlist_label');

    // Mostrar/ocultar configuración cuando se marca el checkbox de PUCHYOUTUBE
    function toggleYoutubeConfig() {
        const active = $('#pub_channels_PUCHYOUTUBE:checked');
        if (active.length >= 1) {
            $('#youtube_advanced_configuration').show();
        } else {
            $('#youtube_advanced_configuration').hide();
        }
    }

    $('.form-group').on('click', toggleYoutubeConfig);
    $(document).ready(toggleYoutubeConfig);

    // Cargar playlists cuando se selecciona una cuenta
    function loadPlaylists(accountId) {
        if (!accountId) {
            playlistSelect.empty();
            playlistSelect.append($('<option value="any">{{ "Without playlist"|trans }}</option>'));
            playlistSelect.select2({
                multiple: true,
                width: 'resolve'
            });
            return;
        }

        console.log('[YouTube] Loading playlists for account:', accountId);

        // Mostrar spinner mientras carga
        playlistSelect.empty();
        playlistSelect.append($('<option value="">{{ "Loading playlists..."|trans }}</option>'));
        playlistSelect.prop('disabled', true);

        // Llamar al endpoint para obtener playlists
        $.ajax({
            url: '{{ path('pumukit_youtube_publication_playlists', {'accountId': '__ACCOUNT_ID__'}) }}'.replace('__ACCOUNT_ID__', accountId),
            method: 'GET',
            success: function(playlists) {
                console.log('[YouTube] Playlists loaded:', playlists);
                
                playlistSelect.empty();
                playlistSelect.prop('disabled', false);
                
                // Añadir opción "Without playlist"
                const withoutPlaylistOption = $('<option value="any">{{ "Without playlist"|trans }}</option>');
                playlistSelect.append(withoutPlaylistOption);
                
                if (playlists.length === 0) {
                    console.warn('[YouTube] No playlists found for account');
                    // Mostrar mensaje informativo
                    $('<div class="alert alert-info" style="margin-top: 10px;">' +
                      '<i class="fa fa-info-circle"></i> {{ "No playlists found for this account. You can create playlists in"|trans }} ' +
                      '<a href="{{ path('pumukit_youtube_playlists_index') }}" target="_blank">{{ "YouTube Playlists Management"|trans }}</a>' +
                      '</div>').insertAfter(playlistSelect.parent());
                }
                
                // Añadir playlists
                $.each(playlists, function(index, playlist) {
                    const option = $('<option></option>')
                        .attr('value', playlist.id)
                        .text(playlist.text);
                    playlistSelect.append(option);
                });
                
                playlistSelect.select2({
                    multiple: true,
                    width: 'resolve',
                    placeholder: '{{ "Select playlists"|trans }}'
                });

                // Restaurar selección previa si existe
                {% if selectedPlaylists|length > 0 %}
                    const selectedIds = {{ selectedPlaylists|json_encode|raw }};
                    console.log('[YouTube] Restoring selected playlists:', selectedIds);
                    playlistSelect.val(selectedIds).trigger('change.select2');
                {% endif %}
            },
            error: function(jqXHR, textStatus, errorThrown) {
                console.error('[YouTube] Error loading playlists:', {
                    status: jqXHR.status,
                    error: errorThrown,
                    response: jqXHR.responseText
                });
                
                playlistSelect.empty();
                playlistSelect.prop('disabled', false);
                playlistSelect.append($('<option value="any">{{ "Without playlist"|trans }}</option>'));
                playlistSelect.select2({
                    multiple: true,
                    width: 'resolve'
                });
                
                // Mostrar mensaje de error
                $('<div class="alert alert-warning" style="margin-top: 10px;">' +
                  '<i class="fa fa-exclamation-triangle"></i> {{ "Could not load playlists. Please try again or contact support."|trans }}' +
                  '</div>').insertAfter(playlistSelect.parent());
            }
        });
    }

    // Inicializar select2 para playlists
    playlistSelect.select2({
        multiple: true,
        width: 'resolve'
    });

    // Cargar playlists al cambiar cuenta
    accountSelect.on('change', function() {
        const accountId = $(this).val();
        loadPlaylists(accountId);
    });

    // Cargar playlists de la cuenta seleccionada inicialmente
    $(document).ready(function() {
        const initialAccountId = accountSelect.val();
        if (initialAccountId) {
            loadPlaylists(initialAccountId);
        }
    });

    // Manejar cambios en la selección de playlists
    playlistSelect.on('select2:select select2:unselect', function(e) {
        const values = playlistSelect.val() || [];
        
        // Si se selecciona "any" (Without playlist), deseleccionar todas las demás
        if (e.params.data.id === 'any') {
            playlistSelect.val(['any']).trigger('change.select2');
        }
        // Si se selecciona una playlist real, quitar "any"
        else if (values.includes('any') && values.length > 1) {
            const newValues = values.filter(v => v !== 'any');
            playlistSelect.val(newValues).trigger('change.select2');
        }
    });
})();
</script>
