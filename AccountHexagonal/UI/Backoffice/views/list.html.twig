{% extends "@PumukitNewAdmin/layout.html.twig" %}

{% block title %}YouTube Accounts Management{% endblock %}

{% block breadcrumbs %}
<ul class="breadcrumb">
    <li><a href="{{ path('pumukit_new_admin_series_list') }}">Series</a></li>
    <li><a href="#">YouTube</a></li>
    <li class="active">Accounts</li>
</ul>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">YouTube Accounts Management</h3>
                </div>
                <div class="panel-body">
                    <!-- Create Account Button -->
                    <div style="margin-bottom: 20px;">
                        <button id="create-account-btn" class="btn btn-success" data-toggle="modal" data-target="#createAccountModal">
                            <i class="fa fa-plus"></i> Add Account
                        </button>
                    </div>

                    <!-- Accounts Table -->
                    {% if accounts is not empty %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Account Name</th>
                                        <th>Channel ID</th>
                                        <th>Credentials Path</th>
                                        <th>Status</th>
                                        <th>Created At</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for account in accounts %}
                                        <tr>
                                            <td>{{ account.accountName|default('N/A') }}</td>
                                            <td>{{ account.channelId|default('Not authenticated') }}</td>
                                            <td><code>{{ account.credentialsPath|default('N/A') }}</code></td>
                                            <td>
                                                <span class="label {% if not account.paused %}label-success{% else %}label-warning{% endif %}">
                                                    {{ account.paused ? 'Paused' : 'Active' }}
                                                </span>
                                            </td>
                                            <td>{{ account.createdAt ? account.createdAt.format('Y-m-d H:i:s') : 'N/A' }}</td>
                                            <td>
                                                <button class="btn btn-sm btn-primary" data-account-id="{{ account.id }}">
                                                    <i class="fa fa-edit"></i> Edit
                                                </button>
                                                <button class="btn btn-sm btn-danger" data-account-id="{{ account.id }}" onclick="deleteAccount('{{ account.id }}')">
                                                    <i class="fa fa-trash"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <p>No YouTube accounts configured yet. <a href="#" data-toggle="modal" data-target="#createAccountModal">Add your first account</a>.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Account Modal -->
<div class="modal fade" id="createAccountModal" tabindex="-1" role="dialog" aria-labelledby="createAccountModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="createAccountModalLabel">
                    <i class="fa fa-youtube-play"></i> Add YouTube Account
                </h4>
            </div>
            <div class="modal-body">
                <form id="createAccountForm">
                    <div class="form-group">
                        <label for="accountName">Account Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="accountName" name="name" 
                               placeholder="e.g., my-youtube-account" required
                               pattern="[a-zA-Z0-9_-]+"
                               title="Only letters, numbers, underscores and hyphens allowed">
                        <p class="help-block">A unique identifier for this account (letters, numbers, underscores, hyphens)</p>
                    </div>
                    <div class="form-group">
                        <label for="credentialsPath">Path to JSON Credentials File <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="credentialsPath" name="credentialsPath" 
                               placeholder="/srv/pumukit/config/youtube_accounts/client_secret.json" required>
                        <p class="help-block">
                            Full path to the Google OAuth 2.0 client secret JSON file.<br>
                            <small class="text-muted">Download from Google Cloud Console → Credentials → OAuth 2.0 Client IDs</small>
                        </p>
                    </div>
                </form>
                <div id="createAccountAlert" class="alert" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="submitCreateAccount" onclick="createAccount()">
                    <i class="fa fa-plus"></i> Create Account
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function createAccount() {
    var name = document.getElementById('accountName').value.trim();
    var credentialsPath = document.getElementById('credentialsPath').value.trim();
    var alertDiv = document.getElementById('createAccountAlert');
    var submitBtn = document.getElementById('submitCreateAccount');
    
    // Validation
    if (!name || !credentialsPath) {
        showAlert('danger', 'Please fill in all required fields.');
        return;
    }
    
    // Disable button and show loading
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Creating...';
    
    fetch('{{ path("pumukit_youtube_accounts_create") }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            name: name,
            credentialsPath: credentialsPath
        })
    })
    .then(function(response) {
        return response.json();
    })
    .then(function(data) {
        if (data.success) {
            showAlert('success', 'Account creation queued successfully! The page will refresh shortly.');
            setTimeout(function() {
                location.reload();
            }, 2000);
        } else {
            showAlert('danger', data.message || 'Failed to create account');
            resetButton();
        }
    })
    .catch(function(error) {
        showAlert('danger', 'Network error: ' + error.message);
        resetButton();
    });
    
    function showAlert(type, message) {
        alertDiv.className = 'alert alert-' + type;
        alertDiv.textContent = message;
        alertDiv.style.display = 'block';
    }
    
    function resetButton() {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa fa-plus"></i> Create Account';
    }
}

function deleteAccount(accountId) {
    if (!confirm('Are you sure you want to delete this account?')) {
        return;
    }
    
    fetch('{{ path("pumukit_youtube_accounts_index") }}/' + accountId, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(function(response) {
        return response.json();
    })
    .then(function(data) {
        if (data.success) {
            location.reload();
        } else {
            alert('Failed to delete account: ' + (data.message || 'Unknown error'));
        }
    })
    .catch(function(error) {
        alert('Network error: ' + error.message);
    });
}

// Clear form when modal is opened
document.getElementById('createAccountModal').addEventListener('show.bs.modal', function() {
    document.getElementById('createAccountForm').reset();
    document.getElementById('createAccountAlert').style.display = 'none';
});
</script>
{% endblock %}
