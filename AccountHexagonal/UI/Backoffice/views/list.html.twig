{% extends "@PumukitNewAdmin/layout.html.twig" %}

{% block title %}YouTube Accounts Management{% endblock %}

{% block breadcrumbs %}
<ul class="breadcrumb">
    <li><a href="{{ path('pumukit_new_admin_series_list') }}">Series</a></li>
    <li><a href="#">YouTube</a></li>
    <li class="active">Accounts</li>
</ul>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">YouTube Accounts Management</h3>
                </div>
                <div class="panel-body">
                    <!-- Create Account Button -->
                    <div style="margin-bottom: 20px;">
                        <button id="create-account-btn" class="btn btn-success" onclick="openCreateAccountModal()">
                            <i class="fa fa-plus"></i> Add Account
                        </button>
                    </div>

                    <!-- Accounts Table -->
                    {% if accounts is not empty %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Account Name</th>
                                        <th>Email</th>
                                        <th>Channel ID</th>
                                        <th>Status</th>
                                        <th>Created At</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for account in accounts %}
                                        <tr>
                                            <td>{{ account.name|default('N/A') }}</td>
                                            <td>{{ account.email|default('N/A') }}</td>
                                            <td>{{ account.channelId|default('N/A') }}</td>
                                            <td>
                                                <span class="label {% if account.active %}label-success{% else %}label-danger{% endif %}">
                                                    {{ account.active ? 'Active' : 'Inactive' }}
                                                </span>
                                            </td>
                                            <td>{{ account.createdAt ? account.createdAt.format('Y-m-d H:i:s') : 'N/A' }}</td>
                                            <td>
                                                <button class="btn btn-sm btn-primary" data-account-id="{{ account.id }}">Edit</button>
                                                <button class="btn btn-sm btn-danger" data-account-id="{{ account.id }}">Delete</button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <p>No YouTube accounts configured yet. <a href="#" onclick="openCreateAccountModal()">Add your first account</a>.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function openCreateAccountModal() {
    // Placeholder for create account modal
    alert('Create Account functionality coming soon');
}
</script>
{% endblock %}
